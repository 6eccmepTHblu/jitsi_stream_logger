{
    "manifest_version": 3,
    "key": "",
    "name": "Jitsi Stream Logger Bridge",
    "version": "1.1.0",
    "description": "Сообщает локальному приложению Jitsi Stream Logger о созвонах Jitsi Meet (только на разрешённых доменах).",
    "minimum_chrome_version": "116",
    "background": {
        "service_worker": "sw.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://meet.jit.si/*"
            ],
            "js": ["page-hook.js"],
            "run_at": "document_idle",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://meet.jit.si/*"
            ],
            "js": ["bridge.js"],
            "run_at": "document_idle"
        }
    ]
}
